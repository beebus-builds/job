# ---- copy to .env and fill in ----
# Backend
JWT_SECRET=change-me-to-32-plus-random-chars
ADMIN_TOKEN=change-me-to-something-private
FRONTEND_URL=http://localhost:3000
DB_PATH=
# Email via Gmail (recommended) — just these two lines, nothing else needed:
# 1. Google Account → Security → turn ON 2-Step Verification
# 2. Security → search "App passwords" → create one for "Mail" → 16-letter code
# 3. Put your Gmail + that code here (NOT your normal password)
SMTP_USER=you@gmail.com
SMTP_PASS=abcd-efgh-ijkl-mnop
# Optional overrides (defaults already suit Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM=you@gmail.com
# SMS — Sparrow (Nepal) or generic webhook; empty = log mode
SPARROW_TOKEN=
SPARROW_FROM=InfoSms
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# eSewa ePay v2 — empty = manual featuring only
ESEWA_MERCHANT=
ESEWA_SECRET=
ESEWA_MODE=test
FEATURE_PRICE_NPR=499
# Google login
GOOGLE_CLIENT_ID=
# Frontend (public, baked at build time)
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
